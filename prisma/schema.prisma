generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  draft
  created
  funding
  funded
  settling
  settled
  payout_pending
  completed
  failed
}

enum PayoutCurrency {
  USDC
  NGN
}

enum SettlementAttemptStatus {
  pending
  settled
  failed
}

enum SettlementVerificationStatus {
  unverified
  pending
  verified
  simulated
  failed
}

enum RecipientSettlementPreference {
  KEEP_STABLECOIN
  CONVERT_TO_NGN
}

enum TreasuryEntryType {
  CREDIT
  RESERVE
  RELEASE
  DEBIT
  ADJUSTMENT
}

enum SettlementBatchStatus {
  pending
  settled
  failed
}

model Business {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  recipients Recipient[]
  payments  Payment[]
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions     AuthSession[]
  createdAt    DateTime      @default(now())
  @@index([businessId])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Recipient {
  id                 String         @id @default(cuid())
  businessId         String
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  identifier         String
  country            String         @default("NG")
  payoutCurrency     PayoutCurrency @default(NGN)
  tempoAddress       String?
  accountId          String?
  account            RecipientAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  payments           Payment[]
  @@unique([businessId, identifier])
  @@index([businessId])
  @@index([accountId])
}

model RecipientAccount {
  id           String                @id @default(cuid())
  email        String                @unique
  name         String
  passwordHash String
  recipients   Recipient[]
  sessions     RecipientAuthSession[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model RecipientAuthSession {
  id                 String           @id @default(cuid())
  tokenHash          String           @unique
  recipientAccountId String
  recipientAccount   RecipientAccount @relation(fields: [recipientAccountId], references: [id], onDelete: Cascade)
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  @@index([recipientAccountId])
  @@index([expiresAt])
}

model Payment {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipientId     String
  recipient       Recipient     @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(18, 2)
  asset           String        @default("USDC")
  country         String        @default("NG")
  payoutCurrency  PayoutCurrency
  recipientPreference RecipientSettlementPreference?
  recipientPreferenceSelectedAt DateTime?
  reference       String?
  status          PaymentStatus @default(draft)
  transactionHash String?       @unique
  fundingAuthorizationSignature String?
  chainId         Int?
  tokenAddress    String?
  senderAddress   String?
  destinationAddress String?
  blockNumber     BigInt?
  blockHash       String?
  confirmedAt     DateTime?
  fundingError    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  settlements     PaymentSettlement[]
  @@index([businessId, createdAt])
  @@index([recipientId])
  @@index([status])
}

model TreasuryAccount {
  id              String   @id @default(cuid())
  chainId         Int
  tokenAddress    String
  tokenSymbol     String
  tokenDecimals   Int
  treasuryAddress String
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  entries         TreasuryLedgerEntry[]
  batches         SettlementBatch[]

  @@unique([chainId, tokenAddress, treasuryAddress])
}

model TreasuryLedgerEntry {
  id                String             @id @default(cuid())
  treasuryAccountId String
  treasuryAccount   TreasuryAccount    @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  paymentId         String?
  type              TreasuryEntryType
  amountUnits       BigInt
  balanceAfterUnits BigInt
  reservationId     String?
  reservation       TreasuryLedgerEntry?  @relation("ReservationLink", fields: [reservationId], references: [id], onDelete: Restrict)
  consumptions      TreasuryLedgerEntry[] @relation("ReservationLink")
  idempotencyKey    String             @unique
  reference         String?
  createdAt         DateTime           @default(now())

  @@index([treasuryAccountId, type])
  @@index([paymentId])
}

model SettlementBatch {
  id                     String                @id @default(cuid())
  treasuryAccountId      String?
  treasuryAccount        TreasuryAccount?      @relation(fields: [treasuryAccountId], references: [id], onDelete: SetNull)
  providerIdempotencyKey String                @unique
  paymentIds             String[]
  status                 SettlementBatchStatus @default(pending)
  transactionHash        String?               @unique
  failureReason          String?
  retryable              Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  settledAt              DateTime?
  failedAt               DateTime?

  attempts PaymentSettlement[]
}

model PaymentSettlement {
  id                         String                        @id @default(cuid())
  paymentId                  String
  payment                    Payment                       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  attemptNumber              Int
  batchId                    String?
  batch                      SettlementBatch?              @relation(fields: [batchId], references: [id], onDelete: SetNull)
  provider                   String
  providerIdempotencyKey     String                        @unique
  status                     SettlementAttemptStatus       @default(pending)
  verificationStatus         SettlementVerificationStatus  @default(unverified)
  isSimulation               Boolean                       @default(false)
  retryable                  Boolean                       @default(false)
  sourceChainId              Int?
  destinationChainId         Int?
  sourceAsset                String?
  sourceTokenAddress         String?
  destinationAsset           String?
  destinationTokenAddress    String?
  sourceAmount               Decimal?                      @db.Decimal(36, 18)
  destinationAmount          Decimal?                      @db.Decimal(36, 18)
  recipientAddress           String?
  sourceTransactionHash      String?
  // Intentionally NOT unique: one atomic batch transaction backs every
  // attempt in the batch, so sibling attempts legitimately share this hash.
  // Double-record protection lives in the debit idempotency keys plus the
  // per-payment memo verification, not in this column.
  destinationTransactionHash String?
  bridgeMessageId            String?                       @unique
  initiatedAt                DateTime                      @default(now())
  verifiedAt                 DateTime?
  settledAt                  DateTime?
  failedAt                   DateTime?
  failureReason              String?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  @@unique([paymentId, attemptNumber])
  @@index([paymentId, status])
  @@index([destinationTransactionHash])
}
